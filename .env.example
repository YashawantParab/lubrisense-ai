# LubriSense AI — local environment configuration template.
#
# Copy this file to `.env` for docker-compose (`cp .env.example .env`) and adjust values
# as needed. `.env` is git-ignored — never commit real secrets. Every value below has a
# safe local-development default baked into docker-compose.yml / backend/app/core/config.py,
# so an empty or partial `.env` still works.

# --- Application ---
APP_NAME=lubrisense-backend
APP_VERSION=0.1.0
APP_ENV=local
LOG_LEVEL=INFO
# json (machine-readable, default) or console (human-readable, easier to read locally)
LOG_FORMAT=json

# --- PostgreSQL / TimescaleDB / pgvector ---
# See TECHNICAL_DECISIONS.md ADR-014 for why one image provides all three.
POSTGRES_USER=lubrisense
POSTGRES_PASSWORD=lubrisense
POSTGRES_DB=lubrisense
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_PORT=6379

# --- MQTT (Eclipse Mosquitto) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Kafka (KRaft, single-node) ---
KAFKA_PORT=9092

# --- Telemetry Pipeline (Phase 6 — MQTT -> Kafka bridge -> consumer -> TimescaleDB) ---
# See docs/TELEMETRY_PIPELINE.md for the full design.
KAFKA_TELEMETRY_TOPIC=lubrisense.telemetry.v1
KAFKA_DLQ_TOPIC=lubrisense.telemetry.dlq.v1
KAFKA_CONSUMER_GROUP_ID=lubrisense-telemetry-consumer
MQTT_TOPIC_PATTERN=lubrisense/v1/+/+/telemetry
PIPELINE_BATCH_SIZE=500
PIPELINE_BATCH_TIMEOUT_SECONDS=2.0
PIPELINE_RETRY_MAX_BACKOFF_SECONDS=30.0
PIPELINE_SUPPORTED_SCHEMA_VERSIONS=1
# Durable local spool the MQTT->Kafka bridge uses when Kafka is unreachable (ADR-056).
# Container path (see docker-compose.yml mqtt-bridge volume); override for local runs.
PIPELINE_BRIDGE_SPOOL_PATH=./data/mqtt_bridge_spool.db
PIPELINE_BRIDGE_SPOOL_DRAIN_INTERVAL_SECONDS=5.0
MQTT_BRIDGE_HEALTH_PORT=8081
TELEMETRY_CONSUMER_HEALTH_PORT=8082

# --- Data Quality Engine (Phase 7 — independent Kafka consumer group + periodic window
# evaluation; see docs/DATA_QUALITY.md) ---
DATA_QUALITY_CONSUMER_GROUP_ID=lubrisense-data-quality
DATA_QUALITY_WORKER_HEALTH_PORT=8083
DATA_QUALITY_WINDOW_EVALUATION_INTERVAL_SECONDS=60.0
# Override the demo policy file (app/data_quality/config/demo_quality_policy.yaml) here.
# DATA_QUALITY_POLICY_PATH=/path/to/custom_quality_policy.yaml

# --- Baseline Engine (Phase 8 — periodic refresh worker, not a Kafka consumer; see
# docs/BASELINES.md) ---
BASELINE_WORKER_HEALTH_PORT=8084
BASELINE_REFRESH_INTERVAL_SECONDS=300.0
# Override the demo policy file (app/baselines/config/demo_baseline_policy.yaml) here.
# BASELINE_POLICY_PATH=/path/to/custom_baseline_policy.yaml

# --- Rules Engine (Phase 9 — periodic evaluation worker, not a Kafka consumer; see
# docs/RULES_ENGINE.md) ---
RULES_WORKER_HEALTH_PORT=8085
RULES_WORKER_CYCLE_SECONDS=300.0
# Override the demo policy file (app/rules_engine/config/demo_rules_policy.yaml) here.
# RULES_POLICY_PATH=/path/to/custom_rules_policy.yaml

# --- Backend ---
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*

# --- Frontend ---
FRONTEND_PORT=3000
NODE_ENV=production
# Browser-safe (see frontend/src/lib/env/public.ts) — the URL the browser uses to reach
# the backend. Defaults to the host-mapped backend port, not the internal Docker network
# address (see BACKEND_INTERNAL_URL below).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
# Dev-only stand-in for tenant context until real authentication exists (Phase 2 — see
# backend/app/api/deps.py and docs/ASSET_HIERARCHY.md). This is the deterministic id of
# the demo tenant created by `backend/scripts/seed_demo_data.py`; recompute it with
# `uuid.uuid5(SEED_NAMESPACE, "tenant:lubrisense-demo")` if the seed script's namespace
# ever changes.
NEXT_PUBLIC_DEMO_TENANT_ID=bbdd114e-b5a7-5890-a5bd-9e8c787a5fe0
# Server-only (see frontend/src/lib/env/server.ts) — used by server components/route
# handlers running inside the frontend container, which must reach the backend via the
# Docker network rather than the host-mapped port.
BACKEND_INTERNAL_URL=http://backend:8000
